# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public HTTPS URL of this running service. Meta must be able to download /api/media/<reel-id>.mp4.
APP_URL="https://your-public-host.example.com"

# META GRAPH API / INSTAGRAM CREDENTIALS
# The Instagram professional account must have content publishing and comment-management permissions.
META_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
META_API_VERSION="v26.0"

# Optional runtime overrides.
FFMPEG_PATH="ffmpeg"
META_STATUS_POLL_MS="60000"
META_MAX_STATUS_POLLS="5"
